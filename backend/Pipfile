[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
sqlalchemy = "*"
alembic = "*"  # database schema migrations
passlib = {extras = ["bcrypt"], version = "*"}
bcrypt = "==4.0.1"  # pinned: passlib 1.7.x is incompatible with bcrypt 5.x
python-jose = {extras = ["cryptography"], version = "*"}
python-multipart = "*"
pydantic-settings = "*"
google-auth = "*"
requests = "*"
apscheduler = "*"
psycopg2-binary = "*"  # PostgreSQL driver (production database)

[dev-packages]
pytest = "*"
httpx = "*"

[requires]
python_version = "3.12"
