# SQLite (dev default) or PostgreSQL, e.g.
#   postgresql://USER:PASS@host:5432/dbname?sslmode=require   (Neon/managed PG)
DATABASE_URL=sqlite:///./data/crm.sqlite3
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated allowed CORS origins (the frontend's public URL(s)).
CORS_ORIGINS=http://localhost:3001

# Seed the demo org/admin/sample data on startup. MUST be false in production.
SEED_DEMO_DATA=true

# --- Google Sign-In (GIS token flow) ---
# Backend verifies Google ID tokens against this client id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary signed upload (org logos) ---
# Secret stays server-side; the backend signs uploads and the browser POSTs the
# file straight to Cloudinary. cloud_name is public (it appears in image URLs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=org_logos

# Reminder scheduler scan interval (seconds).
REMINDER_SCAN_INTERVAL_SECONDS=300

# --- Email / signup verification ---
FRONTEND_URL=http://localhost:3001
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# SMTP: leave SMTP_HOST empty for dev mode (link printed to backend logs).
EMAIL_FROM=ibexprogrammer@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ibexprogrammer@gmail.com
SMTP_PASSWORD=hcxecpjxwnsjyyou

