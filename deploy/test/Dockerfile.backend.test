# Test-site backend image with pinned packages.
# Same app, same start command as the repo's backend/Dockerfile (the workflow checks that file's hash),
# but packages come from a full pinned list taken from the running test image, not from "latest".
# Packages: exact copy of the running image's pip freeze --all (operator read-only baseline).
# BASE IMAGE: the running image's exact base digest is UNKNOWN (python:3.12-slim was not on the host).
# The line below is a PROPOSED REPLACEMENT, not a proven match: the amd64 digest of python:3.12.16-slim
# (also what 3.12-slim pointed to on 2026-10-29, per Docker Hub). The running image reports Python 3.12.16.
# The workflow checks python --version and the full package list after the build.
ARG BASE_IMAGE=python:3.12.16-slim@sha256:1148dbb014615300fa7e713b2f94f550c0d1c69780c0805f84f093ceee34dd0b
FROM ${BASE_IMAGE}
WORKDIR /app
COPY test-backend-pins.txt ./
RUN pip install --no-cache-dir -r test-backend-pins.txt
COPY . .
RUN mkdir -p /app/data
EXPOSE 8000
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
